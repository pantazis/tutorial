{
  "name": "freemeditation-advanced-learning",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:master-recovery": "node scripts/auth/master-recovery.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:verify": "node scripts/db/verify.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "sass": "1.105.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}